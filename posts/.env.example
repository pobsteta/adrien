# Copie ce fichier en « .env » et remplis les valeurs.  NE COMMITE JAMAIS .env.
# Charge-le avant de lancer le script :  set -a; source posts/.env; set +a

# --- Obligatoire : génération ---
ANTHROPIC_API_KEY=sk-ant-...

# Modèle (optionnel). Défaut : claude-sonnet-4-6
# Alternatives : claude-haiku-4-5-20251001 (moins cher) | claude-opus-4-8 (top qualité)
POSTS_MODEL=claude-sonnet-4-6

# --- Optionnel : envoi dans Notion ---
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=

# --- Optionnel : dossier de sortie locale (défaut posts/out) ---
POSTS_OUTPUT_DIR=posts/out
